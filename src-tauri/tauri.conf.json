{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrophyHunter",
  "version": "0.2.41",
  "identifier": "com.trefotg.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexus Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "icons/icon.ico": "nexus-studio.ico",
      "resources/fortnite-reader/NexusFortniteReader.exe": "nexus-fortnite-reader.exe",
      "../tools/fortnite-reader/COPYING-GPL-3.0.txt": "fortnite-reader-COPYING.txt",
      "../tools/fortnite-reader/NOTICE.md": "fortnite-reader-NOTICE.md",
      "../tools/fortnite-reader/LICENSE-LED-N.txt": "fortnite-reader-LICENSE-LED-N.txt",
      "../tools/fortnite-reader/vendor/lib/LICENSE-FortniteReplayDecompressor": "fortnite-reader-LICENSE-Shiqan.txt"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/nexus-hooks.nsh"
      }
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
